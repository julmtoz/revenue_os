      "id": "2",
      "name": "DGE Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        -540,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $input.first().json;\nconst niches = ['roofing','HVAC','plumbing','med spa','dentist','personal injury law','home remodeling','auto repair','property management','commercial cleaning'];\nconst signals = [\n  {type:'demand_spend', phrase:'businesses spending on lead generation digital marketing ads'},\n  {type:'hiring', phrase:'hiring marketing sales lead generation automation'},\n  {type:'competition', phrase:'agencies serving this niche lead generation marketing automation'}\n];\nreturn niches.flatMap(niche => signals.map(signal => ({json:{\n  base_url:cfg.base_url,\n  api_key:cfg.api_key,\n  niche,\n  signal_type:signal.type,\n  query:`DGE_NICHE=${niche} | DGE_SIGNAL=${signal.type} | US ${niche} ${signal.phrase}`\n}})));"
      },
      "id": "3",
      "name": "Generate Demand Queries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.base_url + '/v1/research' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-DGE-API-Key",
              "value": "={{ $json.api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({query:$json.query}) }}",
        "options": {}
      },
      "id": "4",
      "name": "Collect Evidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -60,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('DGE Config').first().json;\nconst items = $input.all().map(item => {\n  const q = item.json.query || '';\n  const nicheMatch = q.match(/DGE_NICHE=([^|]+)\\s*\\|/);\n  const signalMatch = q.match(/DGE_SIGNAL=([^|]+)\\s*\\|/);\n  return {\n    niche: nicheMatch ? nicheMatch[1].trim() : 'unknown',\n    signal_type: signalMatch ? signalMatch[1].trim() : 'general',\n    query: q,\n    summary: item.json.summary || '',\n    results: Array.isArray(item.json.results) ? item.json.results : []\n  };\n});\nreturn [{json:{base_url:cfg.base_url,api_key:cfg.api_key,items}}];"
      },
      "id": "5",
      "name": "Build Evidence Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.base_url + '/v1/market-intelligence/evidence/batch' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-DGE-API-Key",
              "value": "={{ $json.api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({items:$json.items}) }}",
        "options": {}
      },
      "id": "6",
      "name": "Persist and Score Markets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const markets = Array.isArray($json.shortlist) ? $json.shortlist : [];\nreturn markets.map(m => ({json:{...m,decision_status:'HUMAN_REVIEW'}}));"
      },
      "id": "7",
      "name": "Expand Top 5",
