{
  "name": "DGE-02 Safe Gmail Draft Handoff",
  "nodes": [
    {
      "parameters": {},
      "id": "1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -620,
        0
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "base_url",
              "value": "http://host.docker.internal:8787"
            },
            {
              "name": "api_key",
              "value": "CHANGE_ME_DGE_API_KEY"
            }
          ],
          "number": [
            {
              "name": "limit",
              "value": 1
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "DGE Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        -400,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.base_url + '/v1/outreach/drafts?sendability=sendable&require_email=true&limit=' + $json.limit }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-DGE-API-Key",
              "value": "={{ $json.api_key }}"
            }
          ]
        },
        "options": {}
      },
      "id": "3",
      "name": "Read Sendable Drafts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -180,
        0
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "drafts",
        "options": {}
      },
      "id": "4",
      "name": "Split Drafts",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        40,
        0
      ]
    },
    {
      "parameters": {
        "message": "={{ $json.body }}",
        "options": {
          "sendTo": "={{ $json.lead_email }}"
        },
        "subject": "={{ $json.subject }}",
        "resource": "draft",
        "emailType": "text",
        "operation": "create"
      },
      "id": "5",
      "name": "Gmail - Create Draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        260,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "P7st5BStiXMH12dv",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "get",
        "messageId": "={{ $json.id }}",
        "options": {}
      },
      "id": "dge02-verify-draft",
      "name": "Gmail - Verify Draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        480,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "P7st5BStiXMH12dv",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "Draft created in Gmail for human review"
            },
            {
              "name": "decision_status",
              "value": "HUMAN_REVIEW"
            },
            {
              "name": "gmail_draft_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "revenue_os_draft_id",
              "value": "={{ String($('Split Drafts').first().json.id) }}"
            },
            {
              "name": "subject",
              "value": "={{ $('Split Drafts').first().json.subject }}"
            },
            {
              "name": "labels",
              "value": "={{ JSON.stringify($json.message?.labelIds || $json.labelIds || []) }}"
            }
          ],
          "boolean": [
            {
              "name": "draft_created",
              "value": true
            },
            {
              "name": "email_sent",
              "value": false
            }
          ]
        },
        "keepOnlySet": true,
        "options": {}
      },
      "id": "6",
      "name": "Human Review Required",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        700,
        0
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "DGE Config",
            "type": "main",
