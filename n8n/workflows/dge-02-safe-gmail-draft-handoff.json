          }
        ]
      ]
    },
    "DGE Config": {
      "main": [
        [
          {
            "node": "Read Sendable Drafts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Sendable Drafts": {
      "main": [
        [
          {
            "node": "Split Drafts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Drafts": {
      "main": [
        [
          {
            "node": "Gmail - Create Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail - Create Draft": {
      "main": [
        [
          {
            "node": "Gmail - Verify Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
