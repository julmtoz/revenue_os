# Copy this file to .env and fill in your secrets.
OPENAI_API_KEY=sk-...
DEFAULT_CITY=Newark
DEFAULT_NICHE=roofing
OPENAI_MODEL_EMAIL=gpt-4.1-mini
OPENAI_MODEL_AUDIT=gpt-4.1-mini
OPENAI_MODEL_SCORING=gpt-4o-mini
DAILY_OUTREACH_CAP=25
EXPORT_DIR=exports
LOG_DIR=logs

# Optional lead scoring overrides
WEIGHT_HAS_WEBSITE=1
WEIGHT_MISSING_WEBSITE=-2
WEIGHT_HAS_PHONE=1
WEIGHT_VALID_PHONE=1.5
WEIGHT_SHORT_PHONE_PENALTY=-0.5
WEIGHT_NICHE_MATCH=2
WEIGHT_CITY_MATCH=2
WEIGHT_CITY_MISMATCH=-1.5
WEIGHT_LOW_CONTACT=-2
WEIGHT_KEYWORD_MATCH=1
WEIGHT_STUB_PENALTY=-8

# Safety Controls
DRY_RUN=true
APPROVAL_MODE=true
MAX_LEADS_PER_RUN=50
MAX_EMAILS_PER_DAY=20
ALLOW_EXTERNAL_SEND=false
ALLOW_FILE_DELETE=false
ALLOW_WEBSITE_EDIT=false
ALLOW_JOB_APPLY=false

# API Keys
BRAVE_API_KEY=your_brave_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_OWNER_ID=your_telegram_user_id

# Telegram (get chat ID by messaging your bot and checking /getUpdates)
TELEGRAM_OWNER_ID=5092136616

# Environment (dev/staging/production)
ENVIRONMENT=dev
